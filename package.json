{
  "name": "dsh-workspace-sync",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: P2P workspace sync between two machines (macOS/Windows) over LAN — three-way manifest merge, conflict keep-both, token-gated plaintext HTTP transfer, mDNS discovery, chat tools + web panel.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": { "import": "./lib/index.js" },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": { "node": ">=22.19" },
  "dependencies": {
    "bonjour-service": "^1.2.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
